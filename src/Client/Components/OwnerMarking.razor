@preservewhitespace true

@if (Marking is not null)
{
    @if (Marking.UseMarking)
    {
        <div class="owner-marking">
            @if (Marking.ShowOwnerIcon())
            {
                @if (Marking.HasOwnerIcon())
                {
                    <div>
                        <img class="@IconCssClass" src="data:@Marking.Icon!.ContentType;base64,@Marking.Icon.Base64data" />
                    </div>
                }
                else if (Marking.HasOwnerIconHref())
                {
                    <img class="@IconCssClass" src="@Marking.IconHref" />
                }
            }
            else if (Marking.ShowOwnerTextLabel())
            {
                <div>
                    <span class="owner-label">@Marking.TextLabel</span>
                </div>
            }
            else if (Marking.ShowColourMarkings())
            {
                <div>
                    <div class="@InventoryColorCss" style="background-color: @Marking.Color1">&nbsp;</div>
                    @if (Marking.Color2.IsOtherThanWhite())
                    {
                        <div class="@InventoryColorCss" style="background-color: @Marking.Color2">&nbsp;</div>
                    }
                    @if (Marking.Color3.IsOtherThanWhite())
                    {
                        <div class="@InventoryColorCss" style="background-color: @Marking.Color3">&nbsp;</div>
                    }
                    @if (Marking.Color4.IsOtherThanWhite())
                    {
                        <div class="@InventoryColorCss" style="background-color: @Marking.Color4">&nbsp;</div>
                    }
                </div>
            }
            @if (Marking.ShowInventoryNumber())
            {
                <div class="@InventoryNumberCss" style="background-color: @Marking.BackgroundColor(); color: @Marking.BackgroundColor().TextColor()">
                    <span class="@InventoryNumberTextCss">
                        @Marking.InventoryNumber
                    </span>

                </div>
            }
        </div>
    }
}



@code {
    [Parameter] public Marking? Marking { get; set; }
    [Parameter] public Scale? Scale { get; set; }

    bool HasInventoryNumber => !string.IsNullOrWhiteSpace(Marking?.InventoryNumber);
    bool HasIconHref => Marking?.IconHref?.StartsWith("http") == true;
    bool HasTextLabel => Marking?.TextLabel?.HasValue() == true;
    bool HasColor(string? color) => !string.IsNullOrWhiteSpace(color) && !color.Equals("#ffffff", StringComparison.OrdinalIgnoreCase);
    string IconCssClass => $"marking-icon {Scale}";
    string InventoryNumberCss => $"inventory-number {Scale}";
    string InventoryNumberTextCss => $"inventory-number {Scale} text";
    string InventoryColorCss => $"inventory-color {Scale}";
}
