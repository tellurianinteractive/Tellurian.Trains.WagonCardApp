@inject IStringLocalizer<App> Localizer

@if (Data is not null && Owner is not null)
{
    <div style="display:flex;flex-direction:column">
        <div class="card H0" style="border-color: @Data.FrameColor;">
            <div class="card-info H0" style="flex-direction: column;">
                <div class="@Data.LongHeadingCssClass()" style="display:flex; flex-direction: row;">
                    <span>
                        <UicMainClass Data="@Data" />
                    </span>

                    <span class="identification front">
                        @Data.Identification()
                    </span>
                </div>
                <VehicleImage CssClass="front H0" Image="@Data.ModelImage" ImageUrl="@Data.ModelImageUrl" />
                <div style="display: flex; flex-direction: row">
                    <div style="display: flex; flex-direction: column">
                        <div class="marking H0">
                            <div class="label H0">@Localizer.Label("Marking")</div>
                            <OwnerMarking Marking="@Data.Marking" Scale="@Data.Scale" />
                        </div>
                        <div class="owner H0" style="border-right: 1px solid black">
                            <div class="label H0">@Localizer.Label("Owner")</div>
                            @Owner.OwnerName<br />
                            @if (Owner.ClubName.HasValue())
                            {
                                @Owner.ClubName

                                <br />
                            }
                            @Owner.EmailAddress<br />
                            @Owner.PhoneNumber
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column">
                        <div class="model-weight H0">
                            @if (Data.ModelWeight.HasValue)
                            {
                                <div class="label H0">@Localizer.Label("Model weight")</div>
                                <div class="value H0">@Data.ModelWeightGrams</div>
                            }
                        </div>
                        <div style="padding: 2px; width: 5cm; height: 1.8cm; border-right: 1px solid black;">
                            @if (Data.IsCargoWagon)
                            {
                                <UicLabel Data="@Data" FontSize="8" />
                            }
                        </div>

                    </div>
                    <div>
                        <div><img src="@Data.QRCode()" height="130" width="130" /></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card H0" style="display: block; transform: rotate(180deg); border-color: @Data.FrameColor;">
            <div class="card-info H0" style="flex-direction: row;">

                <div class="prototype-info H0">
                    <div class="@Data.ShortHeadingCssClass()" style="display:flex; flex-direction:row;">
                        <span class="identification back">
                            @Data.Identification()
                        </span>
                    </div>
                    <div style="display: flex; flex-direction: row; border-bottom: 1px solid black">
                        @if (Data.Epoch.HasValue())
                        {
                            <div class="property H0" style="border-right: 1px solid black">
                                <div class="label H0">@Localizer.Label("Epoch")</div>
                                <div class="value H0">@Data.Epoch</div>
                            </div>
                        }
                        @if (Data.OperatingFromYear.HasValue || Data.OperatingUptoYear.HasValue)
                        {

                            <div class="property H0">
                                <div class="label H0">@Localizer.Label("Operating period")</div>
                                <div class="value H0">@Data.OperatingFromYear - @Data.OperatingUptoYear</div>
                            </div>
                        }

                    </div>
                    <div class="property row">
                        <div class="@Data.Css("property")">
                            <div class="@Data.Css("label")">@Localizer["Manufacturer"]/@Localizer["Year"]</div>
                            <div class="@Data.Css("value")">@Data.Manufacturer @Data.YearOfManufacturing</div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: row; border-bottom: 1px solid black">
                        @if (Data.LoadLimit > 0)
                        {
                            <div class="property H0" style="border-right: 1px solid black">
                                <div class="label H0">@Localizer.Label("Max")</div>
                                <div class="value H0">@Data.LoadLimit t</div>
                            </div>

                        }
                        @if (Data.LoadArea > 0)
                        {
                            <div class="property H0" style="border-right: 1px solid black">
                                <div class="label H0">@Localizer.Label("Area")</div>
                                <div class="value H0">@Data.LoadArea m²</div>
                            </div>
                        }
                        @if (Data.LoadVolume > 0)
                        {
                            <div class="property H0" style="border-right: 1px solid black">
                                <div class="label H0">@Localizer.Label("Volume")</div>
                                <div class="value H0">@Data.LoadVolume m³</div>
                            </div>
                        }
                        @if (Data.Length > 0)
                        {
                            <div class="property H0">
                                <div class="label H0">@Localizer.Label("Length")</div>
                                <div class="value H0">@Data.Length m</div>
                            </div>
                        }
                    </div>
                    <div style="display: flex; flex-direction: row; border-bottom: 1px solid black">
                        @if (Data.MaxSpeed > 0)
                        {
                            <div class="property H0" style="border-right: 1px solid black">
                                <div class="label H0">@Localizer.Label("Top speed")</div>
                                <div class="value H0">@Data.MaxSpeed  @Localizer[Data.SpeedUnit.ToString()]</div>
                            </div>
                        }
                    </div>

                    @if (Data.IsCargoWagon)
                    {

                        <div class="property H0" style="border-bottom: 1px solid black">
                            <div class="label H0">@Localizer.Label("Interoperability")</div>
                            @if (Data.CountryRegistrationNumber > 0 && Data.InteroperatbilityNumber > 0)
                            {
                                <div class="value H0">
                                    <span>@Data.Interoperability</span>
                                    <span>@Data.CountryRegistrationNumber <u>@Data.CountryCodeOfRegistration</u>-@Data.OperatorSignature @Data.VehicleNumberWithControlDigit()</span>
                                </div>
                            }
                            else
                            {
                                <div class="value H0">@Data.Interoperability</div>
                            }

                        </div>
                    }

                    @if (Data.LoadingInstructions.HasValue())
                    {
                        <div class="property H0" style="border-bottom: 1px solid black; padding-bottom: 4pt">
                            <div class="label H0">@Localizer.Label("Loading instructions")</div>
                            <div class="value H0" style="font-size: 9pt; line-height: 9pt">@Data.LoadingInstructions</div>
                        </div>
                    }
                    <VehicleImage CssClass="back H0" Image="@Data.OriginalImage" ImageUrl="@Data.OriginalImageUrl" />
                </div>
                <div class="pocket">
                    <div style="padding-left: 4cm">
                        <UicMainClass Data="@Data" />
                    </div>

                    @if (@Data.HomeStation?.Name.HasValue() == true)
                    {
                        <div class="homestation" style="color: @Data.HomeStation.Region.Color().TextColor(); background-color: @Data.HomeStation.Region.Color();">
                            <div style="padding-top: 0.5cm; font-size: 60%">@Data.HomeStation.CountryCode.HomeStationLabel()</div>
                            <div>@Data.HomeStation.Name</div>
                            @if (!string.IsNullOrWhiteSpace(Data.HomeStation.CountryCode))
                            {
                                <div>[@Data.HomeStation.CountryCode]</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="pocket-text">
                                @Localizer.Label("Waybill or vehicle schedule")
                                @if (Data.PrintOptions.DisplayQRCode)
                                {
                                    <div><img src="@Data.QRCode()" height="180" width="180" /></div>
                                }
                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Wagon? Data { get; set; }
    [Parameter] public Owner? Owner { get; set; }
}
