@inject IContentService ContentService
@inject IStringLocalizer<App> Localizer

@if (_couldNotLoad)
{
    <p>@Localizer["ContentCouldNotBeLoaded"]</p>
}
else if (_content is null)
{
    @Localizer["Getting content. Please wait..."]
}
else
{
    @((MarkupString)_content.AsHtml)
}

@code {
    private TextContent? _content;
    private bool _couldNotLoad;

    [Parameter] public string? ContentName { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _couldNotLoad = false;
        _content = null;
        if (ContentName is null)
        {
            _content = TextContent.Empty;
            return;
        }
        try
        {
            _content = await ContentService.GetTextContent(ContentName);
        }
        catch (HttpRequestException)
        {
            // Typically offline, and the service worker has no cached copy of this content.
            _couldNotLoad = true;
        }
    }
}
