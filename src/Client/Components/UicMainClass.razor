@if (Data is not null)
{
  <div class="@CssClass" style="background-color: @Data.BackColor; color: @Data.BackColor.TextColor()">
      @Data.MainClass()
</div>  
}

@code {
    [Parameter] public Wagon? Data { get; set; }
    string CssClass => Data is null ? "uicmainclass" : $"uicmainclass {Data.Scale}";
}
