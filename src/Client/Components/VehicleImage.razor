<div class="@OuterCssClass">
    @if (Image is not null)
    {
        <img  src="data:@Image.ContentType;base64,@Image.Base64data" />
    }
    else
    {
        <img  src="@ImageUrl" />
    }
</div>


@code {
    [Parameter] public ImageFile? Image { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;
    string OuterCssClass => string.IsNullOrWhiteSpace(CssClass) ? string.Empty : $"vehicle-image {CssClass}";
}
