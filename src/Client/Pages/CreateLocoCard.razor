@page "/Loco"
@inherits VehicleEditorPage<Loco>

<h3>@Localizer["CreateLocoCard"]</h3>
@if (IsLoaded)
{
    <UploadErrorBanner Message="@ErrorMessage" OnClear="ClearError" />

    <div style="display:flex;flex-direction:row">
        <div>
            <LocoPreview Data="Data" Owner="Owner" />
        </div>
        <div>
            <EditForm Model="Data" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div style="display:flex;flex-direction:row">
                    <div>
                        <ScaleSelector Vehicle="Data" OnChange="StateHasChanged" />

                        <FormSection Title="DataOriginal">
                            <FormRow Label="OperatorSignature" For="OperatorSignature">
                                <InputText class="inputshort" id="OperatorSignature" @bind-Value="Data.OperatorSignature" />
                            </FormRow>
                            <ImageFileInput Label="SelectOperatorLogo" Id="OperatorLogo" @bind-Value="Data.OperatorLogo" />
                            <FormRow Label="VehicleClass" For="VehicleClass">
                                <InputText class="inputshort" id="VehicleClass" @bind-Value="Data.VehicleClass" />
                            </FormRow>
                            <FormRow Label="InteroperabilityCode" For="InteroperabilityCode">
                                <InputNumber class="inputshort" id="InteroperabilityCode" @bind-Value="Data.InteroperatbilityNumber" />
                            </FormRow>
                            <FormRow Label="CountryRegistrationNumber" For="CountryRegistrationNumber">
                                <InputNumber class="inputshort" id="CountryRegistrationNumber" @bind-Value="Data.CountryRegistrationNumber" />
                            </FormRow>
                            <FormRow Label="VehicleNumber" For="VehicleNumber">
                                <InputText class="inputshort" id="VehicleNumber" @bind-Value="Data.VehicleNumber" />
                            </FormRow>
                            <FormRow Label="Epoch" For="Epoch">
                                <InputText class="inputshort" id="Epoch" @bind-Value="Data.Epoch" />
                            </FormRow>
                            <ManufacturerFields Vehicle="Data" OnChange="StateHasChanged" />
                            <OperatingPeriodField Vehicle="Data" OnChange="StateHasChanged" />
                            <FormRow Label="DrivelineType" For="DrivelineType">
                                <InputText class="inputlong" id="DrivelineType" @bind-Value="Data.DrivelineType" />
                            </FormRow>
                            <FormRow Label="EnginePower" For="EnginePower">
                                <InputNumber class="inputshort" id="EnginePower" @bind-Value="Data.EnginePower" />
                                <InputRadioGroup Name="PowerUnit" DisplayName="@Localizer["PowerUnit"]" @bind-Value="Data.EnginePowerUnit">
                                    <InputRadio Value="EnginePowerUnit.Kilowatts" Name="PowerUnit" />@Localizer[nameof(EnginePowerUnit.Kilowatts)]
                                    <InputRadio Value="EnginePowerUnit.Horsepowers" Name="PowerUnit" />@Localizer[nameof(EnginePowerUnit.Horsepowers)]
                                </InputRadioGroup>
                            </FormRow>
                            <SpeedField Vehicle="Data" OnChange="StateHasChanged" />
                            <FormRow Label="LengthOverBuffers" For="Length">
                                <InputNumber class="inputshort" id="Length" @bind-Value="Data.Length" /> m
                            </FormRow>
                            <FormRow Label="Weight" For="Weight">
                                <InputNumber class="inputshort" id="Weight" @bind-Value="Data.Weight" /> t
                            </FormRow>
                            <ImageSourceFields Id="Original" SelectLabel="SelectOriginalImage" UrlLabel="OriginalImageUrl"
                                               @bind-Image="Data.OriginalImage" @bind-ImageUrl="Data.OriginalImageUrl" />
                        </FormSection>

                        <ModelDataFields Vehicle="Data" OnChange="StateHasChanged">
                            <Leading>
                                <FormRow Label="DigitalAddress" For="DigitalAddress">
                                    <input type="number" id="DigitalAddress" @bind="Data.Address" />
                                </FormRow>
                            </Leading>
                            <ChildContent>
                                <FormRow Label="Wheel type" For="WheelType">
                                    <input id="WheelType" @bind="Data.WheelType" />
                                </FormRow>
                                <FormRow Label="FredLocoLabelBackColour" For="SecondColour">
                                    <input id="SecondColour" type="color" @bind="Data.SecondColor" />
                                </FormRow>
                                <FormRow Label="FredFunctionsBackColour" For="MainColour">
                                    <input id="MainColour" type="color" @bind="Data.MainColor" />
                                </FormRow>
                            </ChildContent>
                        </ModelDataFields>

                        <OwnerMarkingFields Marking="Data.Marking" OnChange="StateHasChanged" />
                        <OwnerFields Owner="Owner" OnChange="StateHasChanged" />
                        <PrintOptionsFields Options="Data.PrintOptions" CardLabel="PrintLocoCard" OnChange="StateHasChanged">
                            <FormRow Label="PrintFredSticker" For="PrintFredSticker">
                                <input type="checkbox" id="PrintFredSticker" @bind="Data.PrintOptions.PrintFredSticker" />
                            </FormRow>
                            @if (Data.PrintOptions.PrintFredSticker)
                            {
                                <FormRow Label="PrintExtraFredSticker" For="PrintExtraFredSticker">
                                    <input type="checkbox" id="PrintExtraFredSticker" @bind="Data.PrintOptions.PrintExtraFredSticker" />
                                </FormRow>
                            }
                        </PrintOptionsFields>
                    </div>
                    <div>
                        <FormSection Title="Functions">
                            <div style="display:flex;flex-direction:column; flex-grow: 4">
                                @foreach (var locoFunction in Data.Functions)
                                {
                                    <div>
                                        <label style="font-weight: bold" class="inputlabel" for="@($"F{locoFunction.Key}Text")"> </label>
                                        <input style="font-weight: bold" class="inputshort" id="@($"F{locoFunction.Key}Key")" type="text" @bind="locoFunction.Key" />
                                        <input class="inputwide" id="@($"F{locoFunction.Key}Text")" type="text" @bind="locoFunction.Text" />
                                        <input type="checkbox" @bind="locoFunction.ShowOnFredSticker" />
                                    </div>
                                }
                            </div>
                        </FormSection>
                    </div>
                </div>

                <CardActions OnPrint="PrintAsync" OnExample="ShowExampleAsync" OnReset="Reset"
                             OnDownload="DownloadAsync" OnUpload="UploadAsync" />
            </EditForm>
        </div>
    </div>
}

@code {
    private const string PrintLocoRoute = "printloco";
    private const int DefaultInteroperabilityNumber = 92;
    private const int DefaultFredStickerFunctions = 8;

    protected override string StorageKey => StorageKeys.Loco;
    protected override string PrintRoute => PrintLocoRoute;
    protected override Loco CreateDefault() => Loco.Default;
    protected override Loco? CreateExample() => Loco.Example;

    protected override void Normalize(Loco data)
    {
        if (data.Functions.Length < Loco.MaxFunctions)
        {
            var existingFunctions = data.Functions;
            var nextKey = existingFunctions.Length > 0 ? existingFunctions[^1].Key + 1 : 0;
            data.Functions =
            [
                .. existingFunctions,
                .. Enumerable.Range(nextKey, Loco.MaxFunctions - existingFunctions.Length).Select(key => LocoFunction.Create(key, string.Empty, false))
            ];
        }
        if (data.InteroperatbilityNumber == 0) data.InteroperatbilityNumber = DefaultInteroperabilityNumber;
        if (!data.Functions.Any(f => f.ShowOnFredSticker))
        {
            foreach (var function in data.Functions.Take(DefaultFredStickerFunctions)) function.ShowOnFredSticker = true;
        }
    }
}
