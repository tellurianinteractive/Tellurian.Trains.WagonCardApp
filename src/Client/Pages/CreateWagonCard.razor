@page "/cargowagon"
@page "/passengerwagon"
@inherits VehicleEditorPage<Wagon>
@implements IDisposable

<h3>@Localizer["CreateWagonCard"]</h3>
@if (IsLoaded)
{
    <ErrorBanner Title="@ErrorTitle" Message="@ErrorMessage" OnClear="ClearError" />

    <div style="display:flex;flex-direction:row">
        <div>
            <WagonPreview Data="Data" Owner="Owner" />
        </div>
        <div>
            <EditForm Model="Data" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <ScaleSelector Vehicle="Data" OnChange="StateHasChanged" />

                <FormSection Title="DataOriginal">
                    <FormRow Label="OperatorSignature" For="OperatorSignature">
                        <InputText class="inputshort" id="OperatorSignature" @bind-Value="Data.OperatorSignature" />
                    </FormRow>
                    <FormRow Label="VehicleClass" For="VehicleClass">
                        <InputText class="inputshort" id="VehicleClass" @bind-Value="Data.VehicleClass" />
                    </FormRow>
                    <FormRow Label="OtherUicMainClass" For="UicMainClass">
                        <InputText class="inputshort" id="UicMainClass" @bind-Value="Data.UicMainClass" />
                    </FormRow>
                    <FormRow Label="InteroperabilityCode" For="InteroperabilityCode">
                        <InputNumber class="inputshort" id="InteroperabilityCode" @bind-Value="Data.InteroperatbilityNumber" />
                    </FormRow>
                    <FormRow Label="CountryRegistrationNumber" For="CountryRegistrationNumber">
                        <InputNumber class="inputshort" id="CountryRegistrationNumber" @bind-Value="Data.CountryRegistrationNumber" />
                    </FormRow>
                    <FormRow Label="VehicleNumber" For="VehicleNumber">
                        <input class="inputwide" id="VehicleNumber" @bind="Data.VehicleNumber" @bind:after="ValidateVehicleNumber" />
                        <span style="color: red">@_vehicleNumberErrorMessage</span>
                    </FormRow>
                    <FormRow Label="WagonColour" For="WagonColour">
                        <input id="WagonColour" type="color" @bind="Data.WagonColor" />
                    </FormRow>
                    <FormRow Label="Epoch" For="Epoch">
                        <InputText class="inputshort" id="Epoch" @bind-Value="Data.Epoch" />
                    </FormRow>
                    <OperatingPeriodField Vehicle="Data" OnChange="StateHasChanged" />
                    <SpeedField Vehicle="Data" OnChange="StateHasChanged" />
                    <FormRow Label="LengthOverBuffers" For="Length">
                        <InputNumber class="inputshort" id="Length" @bind-Value="Data.Length" /> m
                    </FormRow>
                    @if (Data.IsPassengerWagon)
                    {
                        <ManufacturerFields Vehicle="Data" OnChange="StateHasChanged" />
                    }
                    else
                    {
                        <FormRow Label="LoadLimit" For="LoadLimit">
                            <InputNumber class="inputshort" id="LoadLimit" @bind-Value="Data.LoadLimit" /> t
                        </FormRow>
                        <FormRow Label="LoadArea" For="LoadArea">
                            <InputNumber class="inputshort" id="LoadArea" @bind-Value="Data.LoadArea" /> m²
                        </FormRow>
                        <FormRow Label="LoadVolume" For="LoadVolume">
                            <InputNumber class="inputshort" id="LoadVolume" @bind-Value="Data.LoadVolume" /> m³
                        </FormRow>
                        <FormRow Label="IsRivConformant" For="IsRivConformant">
                            <InputCheckbox class="inputshort" id="IsRivConformant" @bind-Value="Data.IsRivConformant" />
                        </FormRow>
                        <FormRow Label="IsMcConformant" For="IsMcConformant">
                            <InputCheckbox class="inputshort" id="IsMcConformant" @bind-Value="Data.IsMcConformant" />
                        </FormRow>
                        <FormRow Label="IsEuropConformant" For="IsEuropConformant">
                            <InputCheckbox class="inputshort" id="IsEuropConformant" @bind-Value="Data.IsEuropConformant" />
                        </FormRow>
                        <FormRow Label="IsOpwConformant" For="IsOpwConformant">
                            <InputCheckbox class="inputshort" id="IsOpwConformant" @bind-Value="Data.IsOpwConformant" />
                        </FormRow>
                        <FormRow Label="IsTenConformant" For="IsTenConformant">
                            <InputCheckbox class="inputshort" id="IsTenConformant" @bind-Value="Data.IsTenConformant" />
                        </FormRow>
                        <FormRow Label="IsInterfrigoConformant" For="IsInterfrigoConformant">
                            <InputCheckbox class="inputshort" id="IsInterfrigoConformant" @bind-Value="Data.IsInterfrigoConformant" />
                        </FormRow>
                        <FormRow Label="Loading instructions" For="LoadingInstructions">
                            <textarea rows="2" cols="54" id="LoadingInstructions" @bind="Data.LoadingInstructions"></textarea>
                        </FormRow>
                    }
                    <ImageSourceFields Id="Original" SelectLabel="SelectOriginalImage" UrlLabel="OriginalImageUrl"
                                       @bind-Image="Data.OriginalImage" @bind-ImageUrl="Data.OriginalImageUrl" />
                </FormSection>

                <HomeStationFields HomeStation="Data.HomeStation" OnChange="StateHasChanged" />

                <ModelDataFields Vehicle="Data" OnChange="StateHasChanged">
                    <Leading>
                        <FormRow Label="Model weight" LabelSuffix=" (g)" For="ModelWeight">
                            <input type="number" id="ModelWeight" @bind="Data.ModelWeight" />
                        </FormRow>
                    </Leading>
                </ModelDataFields>

                <OwnerMarkingFields Marking="Data.Marking" OnChange="StateHasChanged" />
                <OwnerFields Owner="Owner" OnChange="SaveOwnerAsync" />
                <PrintOptionsFields Options="Data.PrintOptions" CardLabel="PrintWagonCard" OnChange="StateHasChanged" />

                <CardActions ShowExample="!_isPassengerWagon"
                             OnPrint="PrintAsync" OnExample="ShowExampleAsync" OnReset="Reset"
                             OnDownload="DownloadAsync" OnUpload="UploadAsync" />
            </EditForm>
        </div>
    </div>
}

@code {
    private const string CargoWagonRoute = "cargowagon";
    private const string PassengerWagonRoute = "passengerwagon";
    private const string PrintCargoWagonRoute = "printcargowagon";
    private const string PrintPassengerWagonRoute = "printpassengerwagon";

    private bool _isPassengerWagon;
    private string _vehicleNumberErrorMessage = string.Empty;

    protected override string StorageKey => _isPassengerWagon ? StorageKeys.PassengerWagon : StorageKeys.CargoWagon;
    protected override string PrintRoute => _isPassengerWagon ? PrintPassengerWagonRoute : PrintCargoWagonRoute;
    protected override Wagon CreateDefault() => _isPassengerWagon ? Wagon.PassengerWagonDefault : Wagon.CargoWagonDefault;
    protected override Wagon? CreateExample() => _isPassengerWagon ? null : Wagon.Example;

    protected override void Normalize(Wagon data) => data.HomeStation ??= new();

    protected override async Task<Wagon?> GetStoredDataAsync()
    {
        await MoveMisplacedPassengerWagonAsync();
        return await base.GetStoredDataAsync();
    }

    /// <summary>
    /// Earlier versions saved passenger wagons under the cargo wagon key.
    /// Moves such a wagon to the passenger wagon key, unless a passenger wagon is already saved there.
    /// </summary>
    private async Task MoveMisplacedPassengerWagonAsync()
    {
        if (await LocalStorage.ContainsKeyAsync(StorageKeys.PassengerWagon)) return;
        var stored = await LocalStorage.GetItemAsync<Wagon>(StorageKeys.CargoWagon);
        if (stored is not { IsPassengerWagon: true }) return;
        await LocalStorage.SetItemAsync(StorageKeys.PassengerWagon, stored);
        await LocalStorage.RemoveItemAsync(StorageKeys.CargoWagon);
    }

    protected override async Task OnInitializedAsync()
    {
        _isPassengerWagon = CurrentRoute(Navigator.Uri) == PassengerWagonRoute;
        // Both routes share this component instance, so switching between them must reload the data.
        Navigator.LocationChanged += OnLocationChanged;
        await base.OnInitializedAsync();
    }

    public void Dispose() => Navigator.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var route = CurrentRoute(e.Location);
        if (route is not (CargoWagonRoute or PassengerWagonRoute)) return;
        _isPassengerWagon = route == PassengerWagonRoute;
        _vehicleNumberErrorMessage = string.Empty;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private string CurrentRoute(string uri) =>
        Navigator.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private void ValidateVehicleNumber()
    {
        if (Data.VehicleNumber is null || Data.InteroperatbilityNumber <= 0 || Data.CountryRegistrationNumber <= 0) return;
        _vehicleNumberErrorMessage = Data.VehicleNumberDigits().Length > 7 ? Localizer["MaxSevenDigits"] : string.Empty;
    }
}
